---
import Base from '../layouts/Base.astro';
import ModeView from '../components/ModeView.astro';
import SourceLinks from '../components/SourceLinks.astro';
import { meta, sourcesFor } from '../data/meta';
const modes = Object.values(meta.modes);
---
<Base>
  {modes.map(mode => <ModeView mode={mode} meta={meta} />)}

  <section class="pro-section" aria-labelledby="pros-title">
    <div class="section-title">
      <div><p class="eyebrow">20 performance-qualified players</p><h2 id="pros-title">What pros are running</h2></div>
      <span>Actual captures only</span>
    </div>
    <p class="section-note">{meta.rosterNote}</p>
    <SourceLinks sources={sourcesFor(meta.rosterRosterSourceIds)} label="Roster results" />
    <ol class="pro-list">
      {meta.pros.map(pro => (
        <li class:list={["pro-record", { "pre-reset": pro.last?.preReset }]}>
          <div class="pro-identity">
            <span class="pro-order">{String(pro.order).padStart(2, '0')}</span>
            <div>
              <h3>{pro.name}</h3>
              <p>{pro.team} <span aria-hidden="true">·</span> {pro.result}</p>
              <div class="pro-links">
                {pro.last && <a class="report-link" href={sourcesFor(pro.last.sourceIds)[0].url} target="_blank" rel="noopener noreferrer">{pro.last.preReset ? 'Historical report' : 'Latest reported build'}<span class="sr-only"> for {pro.name} (opens in a new tab)</span><span aria-hidden="true"> ↗</span></a>}
                <a href={pro.twitch} target="_blank" rel="noopener noreferrer">Twitch<span class="sr-only"> for {pro.name} (opens in a new tab)</span><span aria-hidden="true"> ↗</span></a>
                <a href={pro.x} target="_blank" rel="noopener noreferrer">X<span class="sr-only"> for {pro.name} (opens in a new tab)</span><span aria-hidden="true"> ↗</span></a>
              </div>
            </div>
          </div>
          <div class="pro-capture">
            {pro.last ? (
              <>
                <div class="capture-heading">
                  <strong>{pro.last.pair}</strong>
                  <span class:list={["evidence-flag", { neutral: pro.last.preReset }]}>{pro.last.preReset ? 'Pre-reset' : 'Mode-unlabeled'}</span>
                </div>
                <p>{pro.last.note}</p>
                <SourceLinks sources={sourcesFor(pro.last.sourceIds)} compact />
              </>
            ) : (
              <>
                <strong>No Season 1 capture yet</strong>
                <p>No exact current Gunsmith / build evidence was collected in this read. Missing evidence is not evidence of non-use.</p>
                {pro.identityNote && <p class="identity-note">{pro.identityNote}</p>}
              </>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <div class="closing-grid">
    <section class="log-section" aria-labelledby="changelog-title">
      <div class="section-title"><div><p class="eyebrow">Evidence log</p><h2 id="changelog-title">Changelog</h2></div><span>Only material changes</span></div>
      <ol class="change-log">
        {meta.changelog.map(entry => (
          <li><time>{entry.date}</time><h3>{entry.title}</h3><p>{entry.text}</p><SourceLinks sources={sourcesFor(entry.sourceIds)} compact /></li>
        ))}
      </ol>
    </section>
    <section class="official-section" aria-labelledby="official-title">
      <div class="section-title"><div><p class="eyebrow">Confirmed by patch notes</p><h2 id="official-title">Known official changes</h2></div></div>
      <ul class="official-list">
        {meta.officialChanges.map(change => <li>{change.text} <a href={sourcesFor(change.sourceIds)[0].url} target="_blank" rel="noopener noreferrer">Official S1 notes · Nov 5<span class="sr-only"> (opens in a new tab)</span><span aria-hidden="true"> ↗</span></a></li>)}
      </ul>
    </section>
  </div>
</Base>
