---
import Base from '../layouts/Base.astro';
import ModeView from '../components/ModeView.astro';
import SourceLinks from '../components/SourceLinks.astro';
import { meta, sourcesFor, latestSourceDate } from '../data/meta';
const modes = Object.values(meta.modes);
const capturedPros = meta.pros.filter(pro => pro.last && !pro.last.preReset);
const historicalPros = meta.pros.filter(pro => pro.last?.preReset);
const orderedPros = [...capturedPros, ...historicalPros, ...meta.pros.filter(pro => !pro.last)];
---
<Base>
  {modes.map(mode => <ModeView mode={mode} meta={meta} />)}

  <section class="pro-section" aria-labelledby="pros-title">
    <div class="section-title"><h2 id="pros-title">What pros are running</h2></div>
    <p class="section-note">No capture means none collected in this read, not non-use.</p>
    <ol class="pro-list">
      {orderedPros.map(pro => (
        <li class:list={["pro-record", { "pre-reset": pro.last?.preReset, "no-capture": !pro.last }]}>
          {!pro.last ? (
            <div class="empty-capture" aria-label={`${pro.name} · ${pro.team} · no S1 capture`}>
              <div class="pro-identity"><span class="pro-order">{String(pro.order).padStart(2, '0')}</span><h3>{pro.name}</h3><span class="pro-team">· {pro.team}</span><span class="empty-capture-label">· no S1 capture</span></div>
              <div class="pro-links"><a href={pro.twitch} target="_blank" rel="noopener noreferrer">Twitch<span class="sr-only"> for {pro.name} (opens in a new tab)</span> ↗</a><a href={pro.x} target="_blank" rel="noopener noreferrer">X<span class="sr-only"> for {pro.name} (opens in a new tab)</span> ↗</a></div>
            </div>
          ) : (
            <div class="pro-identity"><span class="pro-order">{String(pro.order).padStart(2, '0')}</span><div><h3>{pro.name}</h3><p>{pro.team} · {pro.result}</p></div></div>
          )}
          {pro.last && (
            <div class="pro-capture"><strong>{pro.last.pair}</strong><span class:list={["evidence-flag", { neutral: pro.last.preReset }]}>{pro.last.preReset ? 'Pre-reset' : 'Mode-unlabeled'}</span>
              <details class="pro-evidence"><summary>{pro.last.preReset ? 'Historical evidence' : 'Current evidence'}<span class="details-mark" aria-hidden="true">+</span></summary><div class="evidence-content"><p>{pro.last.note}</p>{pro.identityNote && <p>{pro.identityNote}</p>}<SourceLinks sources={sourcesFor(pro.last.sourceIds)} /></div></details>
            </div>
          )}
          {pro.last && <div class="pro-links"><a class="report-link" href={sourcesFor(pro.last.sourceIds)[0].url} target="_blank" rel="noopener noreferrer">Report<span class="sr-only"> for {pro.name} (opens in a new tab)</span> ↗</a><a href={pro.twitch} target="_blank" rel="noopener noreferrer">Twitch<span class="sr-only"> for {pro.name} (opens in a new tab)</span> ↗</a><a href={pro.x} target="_blank" rel="noopener noreferrer">X<span class="sr-only"> for {pro.name} (opens in a new tab)</span> ↗</a></div>}
        </li>
      ))}
    </ol>
    <details class="roster-details"><summary>20-player tournament roster · selection evidence<span class="details-mark" aria-hidden="true">+</span></summary><div class="evidence-content"><p>{meta.rosterNote}</p><SourceLinks sources={sourcesFor(meta.rosterRosterSourceIds)} /></div></details>
  </section>

  <section class="official-section" aria-labelledby="official-title"><div class="section-title"><h2 id="official-title">Known official changes</h2></div>
    <ul class="official-list">{meta.officialChanges.map(change => <li>{change.text} <a href={sourcesFor(change.sourceIds)[0].url} target="_blank" rel="noopener noreferrer">Official S1 notes · Nov 5<span class="sr-only"> (opens in a new tab)</span><span aria-hidden="true"> ↗</span></a></li>)}</ul>
  </section>
  {meta.changelog.map(entry => <details class="change-log"><summary>Changelog · {meta.changelog.length} entry · {entry.sourceIds.length} sources · latest {latestSourceDate(sourcesFor(entry.sourceIds))}<span class="details-mark" aria-hidden="true">+</span></summary><div class="evidence-content"><p><strong>{entry.date} · {entry.title}</strong></p><p>{entry.text}</p><SourceLinks sources={sourcesFor(entry.sourceIds)} /></div></details>)}
</Base>
