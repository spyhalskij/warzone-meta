  "officialChanges": [
    {
      "text": "Hajin launches as the large BR map; Zodiac is the compact Resurgence map with 10 POIs.",
      "sourceIds": [
        "official"
      ]
    },
    {
      "text": "Full MW4 integration adds 30+ weapons; pre-reset BO7-era TTK comparisons no longer carry over automatically.",
      "sourceIds": [
        "official"
      ]
    },
    {
      "text": "Legacy weapons remain usable only as preset Warzone builds / blueprints; custom Gunsmith editing and build sharing are locked.",
      "sourceIds": [
        "official"
      ]
    },
    {
      "text": "Tactical Sprint returns to default movement; slide, jump and fire transitions are faster. Broad bullet-velocity and handling changes are not named damage buffs.",
      "sourceIds": [
        "official"
      ]
    },
    {
      "text": "One Weapon Augment per weapon: Breacher, Sharpshooter or Gunslinger. Augments persist when dropped and stay separate from attachments.",
      "sourceIds": [
        "official"
      ]
    },
    {
      "text": "Unlocks: Cronen Osprey at Battle Pass tier 16; CSG-35 at tier 36; Han 86 immediately; Astaroth .57 at player level 10.",
      "sourceIds": [
        "official"
      ]
    },
    {
      "text": "Official Combat Record and Leaderboards begin tracking in S1 but become visible in S2; no official live population pick-rate claim is available now.",
      "sourceIds": [
        "official"
      ]
    },
    {
      "text": "The Season 1 notes provide no full per-gun damage table and name no meta winner. Astaroth .57 knockdown ability was removed.",
      "sourceIds": [
        "official"
      ]
    }
  ],
