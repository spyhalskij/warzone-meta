---
import type { GameMode, MetaData } from '../data/types';
import { rolesFor, sourcesFor, latestSourceDate } from '../data/meta';
import RoleGroup from './RoleGroup.astro';
import SourceLinks from './SourceLinks.astro';
interface Props { mode: GameMode; meta: MetaData; }
const { mode, meta } = Astro.props;
const groups = rolesFor(mode);
const withdrawn = mode.cards.filter(card => card.archived);
const base = import.meta.env.BASE_URL;
const jumpLabel = (key: string) => key === 'legacy' ? 'Legacy' : key === 'close' ? 'Close' : key === 'long' ? 'Long' : key === 'support' ? 'Support' : 'Sniper';
---
<section class="mode-content" data-mode-view={mode.id} aria-labelledby={`${mode.id}-title`}>
  <div class="mode-heading">
    <div>
      <p class="eyebrow">{mode.fullLabel} · {mode.map}</p>
      <h1 id={`${mode.id}-title`}>Season 1 watchlist</h1>
    </div>
    <div class="map-readout"><span>Map</span><strong>{mode.map}</strong></div>
  </div>
  <p class="mode-note">{mode.headnote}</p>
  <nav class="role-jump" aria-label={`${mode.label} roles`}>
    {groups.map(group => <a href={`#${group.id}`}>{jumpLabel(group.key)}</a>)}
    <a href={`${base}ttk/`}>TTK</a>
  </nav>
  <div class="section-title" id={`${mode.id}-roles`}><h2>Current recommendations</h2></div>
  {groups.map(group => <RoleGroup role={group} />)}
  {withdrawn.length > 0 && (
    <details class="withdrawn-section">
      <summary>Withdrawn from current picks · {withdrawn.length} dated audit records<span class="details-mark" aria-hidden="true">+</span></summary>
      <div class="withdrawn-list">
        {withdrawn.map(card => (
          <section>
            <h3>{card.weapon}</h3>
            <p class="caveat-line">Withdrawn · Nov 6</p>
            <p>{card.counterpoint}</p>
            <SourceLinks sources={sourcesFor(card.sourceIds.slice(-2))} />
          </section>
        ))}
      </div>
    </details>
  )}
  <details class="sample-section">
    <summary><span>{meta.sample.total}/{meta.sample.trackedTotal} rolling panel · not a pure S1 sample · {meta.sample.sourceIds.length} sources · latest {latestSourceDate(sourcesFor(meta.sample.sourceIds))}</span><span class="details-mark" aria-hidden="true">+</span></summary>
    <div class="evidence-content"><p>{meta.sample.note}</p><SourceLinks sources={sourcesFor(meta.sample.sourceIds)} /></div>
  </details>
</section>
