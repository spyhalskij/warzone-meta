---
import type { MetaCard, Attachment, BaselineCandidate } from '../data/types';
import { formatDate, latestSourceDate, evidenceSourcesFor, meta } from '../data/meta';
import SourceLinks from './SourceLinks.astro';
interface Props { card: MetaCard; }
const { card } = Astro.props;
const sources = evidenceSourcesFor(card);
const captureDate = card.observed.date ? formatDate(card.observed.date) : 'No capture';
const flags = [card.legacy && 'LEGACY', card.modeUnlabeled && 'Mode-unlabeled', card.preReset && 'Pre-reset', card.archived && 'Withdrawn', card.editable, card.unlock].filter(Boolean) as string[];
const visibleFlags = [card.legacy && 'LEGACY', card.modeUnlabeled && 'Mode-unlabeled', card.archived && 'Withdrawn'].filter(Boolean) as string[];
const hasUnknownSlots = card.build?.attachments.some((attachment: Attachment) => attachment.slot === 'Slot unverified');
---
<article class:list={["meta-card", { "legacy-card": card.legacy }]} id={card.id} data-confidence={card.confidence}>
  <div class="card-heading">
    <div class="weapon-heading"><p class="role-label">{card.role}</p><h3>{card.weapon}</h3></div>
    <span class={`confidence confidence-${card.confidence.toLowerCase()}`}>{card.confidence} · {card.sourceIds.length} src</span>
  </div>
  <div class="visible-tags" aria-label="Evidence status">{visibleFlags.map(flag => <span class:list={['evidence-flag',{legacy:flag==='LEGACY'}]}>{flag}</span>)}</div>
  <p class="card-summary">{card.summary}</p>
  <section class="build-section" aria-label={`${card.weapon} current build and evidence`}>
    {card.build ? <>
      <p class="build-owner"><span>{card.build.owner}</span><small>{card.build.status}</small></p>
      {card.build.attachments.length > 0 ? <ol class="attachment-list">{card.build.attachments.map((attachment: Attachment) => <li><span>{attachment.slot}</span><strong>{attachment.name}</strong></li>)}</ol> : <p class="unavailable-build legacy-note">Current legacy preset only. No editable attachment list.</p>}
      {hasUnknownSlots && <p class="slot-note">Slot unverified = the part exists in MW4, but exact weapon fit / category needs a new Gunsmith check.</p>}
    </> : <p class="unavailable-build">{card.id === 'res-pending' ? 'No verified Zodiac pick — close, long, support and sniper remain empty.' : 'No verified current individual build captured. No invented attachment set.'}</p>}
    <div class="meta-strip"><span>{card.observed.display ?? `${card.observed.n}/${card.observed.total}`} · {captureDate}</span>
      {card.test && <span class="calculation"><span class={`measure measure-${card.test.kind.toLowerCase()}`}>{card.test.kind}</span> {card.test.value}</span>}
    </div>
    <details class="evidence"><summary>Evidence · {sources.length} sources · latest {latestSourceDate(sources)}<span class="details-mark" aria-hidden="true">+</span></summary>
      <div class="evidence-content"><div class="flag-row">{flags.map(flag => <span class="evidence-flag neutral">{flag}</span>)}</div>
        <dl class="evidence-readout"><div><dt>{card.observed.dateLabel}</dt><dd>{captureDate}</dd></div><div><dt>Observed use</dt><dd>{card.observed.display ?? `${card.observed.n} / ${card.observed.total} panel`}</dd></div>{card.observed.names.length > 0 && <div><dt>Named users</dt><dd>{card.observed.names.join(' · ')}</dd></div>}</dl>{card.fullSummary && <p>{card.fullSummary}</p>}<p>{card.observed.caveat}</p>{card.build && <><h4>Build provenance</h4><p>{card.build.kind} · {card.build.owner} · {card.build.status}. {card.build.note}</p></>}
        {card.candidates?.map((candidate: BaselineCandidate) => <section class="baseline-candidate"><h4>{candidate.arm}</h4><p class="candidate-owner">{candidate.owner}</p><p>{candidate.note}</p><div class="candidate-source-links"><a href={sources.find(source => candidate.sourceIds.includes(source.id))?.url} target="_blank" rel="noopener noreferrer">Baseline source ↗<span class="sr-only"> · opens in a new tab</span></a></div></section>)}
        <h4>Augment</h4><p>{card.augment || 'No current Weapon Augment selection verified. An in-match augment is not a Gunsmith attachment.'}</p>
        <h4>Source disagreement</h4><p>{card.counterpoint}</p>
        {card.test && <><h4>Calculation limits</h4><p>{card.test.note} {meta.calculationNote}</p></>}
        <h4>Dated sources</h4><SourceLinks sources={sources} />
      </div>
    </details>
  </section>
</article>
