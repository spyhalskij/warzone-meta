---
import type { BaselineCandidate, BuildAttachment, CompetitiveBuild, MetaCard } from '../data/types';
import { buildNote, caveatLine, competitiveBuilds, formatDate, latestSourceDate, evidenceSourcesFor, meta } from '../data/meta';
import SourceLinks from './SourceLinks.astro';
interface Props { card: MetaCard; }
const { card } = Astro.props;
const sources = evidenceSourcesFor(card);
const captureDate = card.observed.date ? formatDate(card.observed.date) : 'No capture';
const caveats = caveatLine(card);
const sample = card.observed.display ?? `${card.observed.n}/${card.observed.total}`;
const builds = competitiveBuilds(card);
const hasBuildList = Array.isArray(card.builds);
const tabbed = builds.length > 1;
const isPick = card.placement === 'pick';
const isAlternative = card.placement === 'alternative';
const partName = (attachment: BuildAttachment) => attachment.status === 'unknown' || attachment.name == null ? 'unknown' : attachment.name;
const tabId = (build: CompetitiveBuild) => `${card.id}-${build.id}-tab`;
const panelId = (build: CompetitiveBuild) => `${card.id}-${build.id}-panel`;
---
<article
  class:list={['meta-card', { 'pick-card': isPick, 'alt-row': isAlternative, 'empty-card': card.placement === 'empty', 'legacy-card': card.legacy }]}
  id={card.id}
  data-confidence={card.confidence}
  data-placement={card.placement}
>
  {isPick && <p class="kicker">Meta pick</p>}
  <div class="card-heading">
    <h3>{card.weapon}</h3>
    {card.placement !== 'empty' && <p class={`confidence confidence-${card.confidence.toLowerCase()}`}>{card.confidence}</p>}
  </div>
  {isAlternative && card.whenToPick && <p class="when-line">{card.whenToPick}</p>}
  <p class:list={['card-summary', { 'when-line': isPick }]}>{card.summary}</p>
  {card.evidenceTags.length > 0 && (
    <ul class="tag-row" aria-label="Evidence tags">
      {card.evidenceTags.map(tag => <li><span class={`tag tag-${tag.toLowerCase()}`}>{tag}</span></li>)}
    </ul>
  )}
  {caveats && <p class="caveat-line">{caveats}</p>}
  <p class="sample-line">{sample}{card.observed.date ? ` · ${captureDate}` : ''}</p>
  {hasBuildList && (
    <section class="build-section" aria-label={builds.length ? `${card.weapon} ${builds.length === 1 ? 'build' : 'builds'}` : `${card.weapon} build`}>
      {builds.length === 0 ? (
        <p class="unavailable-build">{card.legacy ? 'No verified current build. Current legacy preset only. No editable attachment list.' : 'No verified current build. No attachments listed.'}</p>
      ) : (
        <>
          {tabbed && (
            <div class="build-tabs" role="tablist" aria-label={`${card.weapon} builds`} data-build-tabs>
              {builds.map((build, index) => (
                <button
                  type="button"
                  class="build-tab"
                  role="tab"
                  id={tabId(build)}
                  aria-controls={panelId(build)}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? 0 : -1}
                >{build.label}</button>
              ))}
            </div>
          )}
          <div class="build-panels">
            {builds.map((build, index) => {
              const unknown = build.attachments.some(attachment => partName(attachment) === 'unknown');
              return (
                <div
                  class:list={['build-panel', { 'is-selected': index === 0 }]}
                  role={tabbed ? 'tabpanel' : undefined}
                  id={panelId(build)}
                  aria-labelledby={tabbed ? tabId(build) : undefined}
                  aria-hidden={tabbed ? (index === 0 ? 'false' : 'true') : undefined}
                  inert={tabbed && index !== 0 ? true : undefined}
                >
                  <div class="build-meta">
                    <a class="build-source" href={build.url} target="_blank" rel="noopener noreferrer">{build.sourceName}<span class="sr-only"> (opens in a new tab)</span></a>
                    <span class={`tag tag-${build.evidenceType.toLowerCase()}`}>{build.evidenceType}</span>
                  </div>
                  <p class="build-facts"><time datetime={build.date} title={build.dateBasis}>{formatDate(build.date)}</time> <span>· Mode {build.mode}</span></p>
                  <ol class="attachment-list">
                    {build.attachments.map(attachment => {
                      const name = partName(attachment);
                      return <li><span>{attachment.slot}</span><strong class:list={{ 'is-unknown': name === 'unknown' }}>{name}</strong></li>;
                    })}
                  </ol>
                  {unknown && <p class="slot-note">unknown = the source did not list this slot.</p>}
                  <p class="build-note">{buildNote(build)}</p>
                </div>
              );
            })}
          </div>
        </>
      )}
    </section>
  )}
  {!hasBuildList && isPick && card.build && (
    <section class="build-section" aria-label={`${card.weapon} build`}>
      <p class="build-owner"><span>{card.build.owner}</span><small>{card.build.status}</small></p>
      {card.build.attachments.length > 0 ? (
        <ol class="attachment-list">
          {card.build.attachments.map(attachment => <li><span>{attachment.slot}</span><strong>{attachment.name}</strong></li>)}
        </ol>
      ) : <p class="unavailable-build">No verified current build. Current legacy preset only. No editable attachment list.</p>}
      {card.build.attachments.some(attachment => attachment.slot === 'Slot unverified') && <p class="slot-note">Slot unverified = the part exists in MW4, but exact weapon fit / category needs a new Gunsmith check.</p>}
    </section>
  )}
  {!hasBuildList && isAlternative && !card.build && <p class="build-unverified">Build unverified. No attachments listed.</p>}
  {card.test && (
    <p class="calc-line"><span class={`tag tag-${card.test.kind.toLowerCase()}`}>{card.test.kind}</span> <span class="calc-value">{card.test.value}</span></p>
  )}
  <details class="evidence">
    <summary>Evidence · {sources.length} sources · latest {latestSourceDate(sources)}<span class="details-mark" aria-hidden="true">+</span></summary>
    <div class="evidence-content">
      <p>{card.editable}{card.unlock ? ` · Unlock: ${card.unlock}` : ''}</p>
      <dl class="evidence-readout">
        <div><dt>{card.observed.dateLabel}</dt><dd>{captureDate}</dd></div>
        <div><dt>Sample</dt><dd>{sample}</dd></div>
        {card.observed.names.length > 0 && <div><dt>Named users</dt><dd>{card.observed.names.join(' · ')}</dd></div>}
        {card.placement !== 'empty' && <div><dt>Confidence</dt><dd>{card.confidence}</dd></div>}
      </dl>
      {card.fullSummary && <p>{card.fullSummary}</p>}
      <p>{card.observed.caveat}</p>
      {builds.length > 0 && (
        <>
          <h4>Build tabs</h4>
          {builds.map(build => (
            <p><span class={`tag tag-${build.evidenceType.toLowerCase()}`}>{build.evidenceType}</span> <a href={build.url} target="_blank" rel="noopener noreferrer">{build.sourceName}<span class="sr-only"> (opens in a new tab)</span></a> · {formatDate(build.date)} · Mode {build.mode}. {buildNote(build)}</p>
          ))}
        </>
      )}
      {card.build && <><h4>Build provenance</h4><p>{card.build.kind} · {card.build.owner} · {card.build.status}. {card.build.note}</p></>}
      {isAlternative && !card.build && builds.length === 0 && <><h4>Build</h4><p>Build unverified. No attachment was added for this alternative.</p></>}
      {card.placement === 'empty' && !card.build && <p class="unavailable-build">No verified current build. Nothing was invented to fill this role.</p>}
      {card.candidates?.map((candidate: BaselineCandidate) => (
        <section class="baseline-candidate">
          <h4>{candidate.arm}</h4>
          <p class="candidate-owner">{candidate.owner}</p>
          <p>{candidate.note}</p>
          <div class="candidate-source-links"><a href={sources.find(source => candidate.sourceIds.includes(source.id))?.url} target="_blank" rel="noopener noreferrer">Baseline source ↗<span class="sr-only"> · opens in a new tab</span></a></div>
        </section>
      ))}
      <h4>Augment</h4>
      <p>{card.augment || 'No current Weapon Augment selection verified. An in-match augment is not a Gunsmith attachment.'}</p>
      <h4>Source disagreement</h4>
      <p>{card.counterpoint}</p>
      {card.test && <><h4>Calculation limits</h4><p>{card.test.note} {meta.calculationNote}</p></>}
      <h4>Dated sources</h4>
      <SourceLinks sources={sources} />
    </div>
  </details>
</article>
